{
  "name": "omnia-print",
  "productName": "Omnia Print by neXus",
  "version": "1.0.0",
  "description": "Omnia Print by neXus: crea la locandina delle riunioni di condominio Omnia Casa",
  "main": "main.js",
  "author": "Omnia Casa Group · neXus",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist": "electron-builder --win --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^3.11.174"
  },
  "build": {
    "appId": "it.omniacasa.print",
    "productName": "Omnia Print by neXus",
    "copyright": "Omnia Casa Group · neXus",
    "files": [
      "main.js",
      "preload.js",
      "poster.js",
      "renderer/**",
      "assets/**",
      "fonts/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Omnia Print by neXus"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Omnia Print by neXus"
    },
    "electronLanguages": [
      "it",
      "en-US"
    ],
    "compression": "normal"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}